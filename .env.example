# Токен Telegram бота от @BotFather (обязательно)
BOT_TOKEN=your_telegram_bot_token_here

# Ключ Gemini API для продвинутого распознавания сложного текста (опционально)
# Если не указан, работает быстрый локальный парсер без внешних запросов
GEMINI_API_KEY=your_gemini_api_key_here

# Путь к файлу SQLite базы данных (по умолчанию file:todo_bot.db)
DB_PATH=file:todo_bot.db
