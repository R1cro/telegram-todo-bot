# Токен Telegram бота от @BotFather (обязательно)
BOT_TOKEN=your_telegram_bot_token_here

# Ключ Gemini API для распознавания сложного текста и голосовых сообщений (опционально)
# Получить бесплатно: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Модель Gemini (по умолчанию gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Путь к файлу SQLite базы данных (по умолчанию file:todo_bot.db)
# Telegram ID владельца для доступа к команде /audit (можно несколько через запятую)
ADMIN_USER_IDS=

# ID разрешённой группы (по умолчанию -1003905913984)
ALLOWED_CHAT_ID=-1003905913984

DB_PATH=file:todo_bot.db
